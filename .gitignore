# Terraform state and lock files
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/

# Reusable modules must not pin provider versions, so their lock files stay out
# of the repo. Examples are root modules: pinning them keeps example CI
# reproducible, so their lock files are tracked.
.terraform.lock.hcl
!examples/*/.terraform.lock.hcl

# Variable files containing secrets
*.tfvars
*.tfvars.json
!example.tfvars
!*.auto.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
# ...except the one the prod-overrides example exists to demonstrate.
!examples/prod-overrides/override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output
*.tfplan
*.tfplan.*
plan.out

# CLI configuration
.terraformrc
terraform.rc

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store

# Local environment
.env
.env.local

# Generated docs cache
.terraform-docs.tmp
